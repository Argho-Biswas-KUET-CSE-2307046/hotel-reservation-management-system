<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.CustomerController"
        prefWidth="1100.0"
        prefHeight="700.0"
        minWidth="900.0"
        minHeight="600.0"
        style="-fx-background-color: #F5F7FB;">

   <!-- ========================================================= -->
   <!-- TOP HEADER -->
   <!-- ========================================================= -->

   <top>

      <HBox
              alignment="CENTER_LEFT"
              spacing="15.0"
              prefHeight="85.0"
              style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 0 0 1 0;">

         <padding>
            <Insets
                    top="15.0"
                    right="30.0"
                    bottom="15.0"
                    left="30.0"/>
         </padding>

         <!-- TITLE -->

         <VBox spacing="3.0">

            <Label
                    text="CUSTOMER MANAGEMENT"
                    textFill="#1E3A8A">

               <font>
                  <Font
                          name="System Bold"
                          size="26.0"/>
               </font>

            </Label>

            <Label
                    text="Search and manage customer information"
                    textFill="#64748B">

               <font>
                  <Font
                          name="System"
                          size="13.0"/>
               </font>

            </Label>

         </VBox>

         <Region HBox.hgrow="ALWAYS"/>

         <Label
                 text="CUSTOMERS"
                 textFill="#DB2777">

            <font>
               <Font
                       name="System Bold"
                       size="14.0"/>
            </font>

         </Label>

      </HBox>

   </top>


   <!-- ========================================================= -->
   <!-- CENTER -->
   <!-- ========================================================= -->

   <center>

      <VBox
              spacing="18.0"
              VBox.vgrow="ALWAYS"
              style="-fx-background-color: #F5F7FB;">

         <padding>
            <Insets
                    top="25.0"
                    right="30.0"
                    bottom="25.0"
                    left="30.0"/>
         </padding>


         <!-- ================================================= -->
         <!-- SEARCH CARD -->
         <!-- ================================================= -->

         <VBox
                 spacing="12.0"
                 style="-fx-background-color: #FFFFFF;
                           -fx-background-radius: 12;
                           -fx-border-color: #E2E8F0;
                           -fx-border-radius: 12;
                           -fx-border-width: 1;
                           -fx-padding: 20;">

            <HBox alignment="CENTER_LEFT">

               <VBox spacing="3.0">

                  <Label
                          text="Search Customer"
                          textFill="#172554">

                     <font>
                        <Font
                                name="System Bold"
                                size="20.0"/>
                     </font>

                  </Label>

                  <Label
                          text="Search by ID, name, phone, email or address"
                          textFill="#64748B">

                     <font>
                        <Font
                                name="System"
                                size="12.0"/>
                     </font>

                  </Label>

               </VBox>

               <Region HBox.hgrow="ALWAYS"/>

               <Label
                       text="LIVE SEARCH"
                       textFill="#2563EB">

                  <font>
                     <Font
                             name="System Bold"
                             size="12.0"/>
                  </font>

               </Label>

            </HBox>


            <!-- ================================================= -->
            <!-- SEARCH FIELD -->
            <!-- ================================================= -->

            <TextField
                    fx:id="searchField"
                    promptText="Type customer ID, name, phone, email or address..."
                    prefHeight="45.0"
                    maxWidth="Infinity"
                    style="-fx-background-color: #F8FAFC;
                               -fx-border-color: #CBD5E1;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-padding: 10;
                               -fx-font-size: 14px;"/>

            <Label
                    text="Results update automatically while you type."
                    textFill="#64748B">

               <font>
                  <Font
                          name="System Italic"
                          size="11.0"/>
               </font>

            </Label>

         </VBox>


         <!-- ================================================= -->
         <!-- CUSTOMER TABLE CARD -->
         <!-- ================================================= -->

         <VBox
                 spacing="12.0"
                 VBox.vgrow="ALWAYS"
                 style="-fx-background-color: #FFFFFF;
                           -fx-background-radius: 12;
                           -fx-border-color: #E2E8F0;
                           -fx-border-radius: 12;
                           -fx-border-width: 1;
                           -fx-padding: 20;">

            <!-- TABLE HEADER -->

            <HBox alignment="CENTER_LEFT">

               <VBox spacing="3.0">

                  <Label
                          text="Customer List"
                          textFill="#172554">

                     <font>
                        <Font
                                name="System Bold"
                                size="20.0"/>
                     </font>

                  </Label>

                  <Label
                          text="Select a customer to update, delete or make a booking"
                          textFill="#64748B">

                     <font>
                        <Font
                                name="System"
                                size="12.0"/>
                     </font>

                  </Label>

               </VBox>

               <Region HBox.hgrow="ALWAYS"/>

               <Label
                       text="CUSTOMER RECORDS"
                       textFill="#DB2777">

                  <font>
                     <Font
                             name="System Bold"
                             size="12.0"/>
                  </font>

               </Label>

            </HBox>


            <!-- ================================================= -->
            <!-- CUSTOMER TABLE -->
            <!-- ================================================= -->

            <TableView
                    fx:id="customerTable"
                    VBox.vgrow="ALWAYS"
                    prefHeight="400.0"
                    style="-fx-background-color: #FFFFFF;
                               -fx-border-color: #CBD5E1;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;">

               <columns>

                  <!-- CUSTOMER ID -->

                  <TableColumn
                          fx:id="customerIdColumn"
                          text="Customer ID"
                          minWidth="100.0"
                          prefWidth="130.0"/>


                  <!-- NAME -->

                  <TableColumn
                          fx:id="nameColumn"
                          text="Name"
                          minWidth="150.0"
                          prefWidth="200.0"/>


                  <!-- PHONE -->

                  <TableColumn
                          fx:id="phoneColumn"
                          text="Phone"
                          minWidth="150.0"
                          prefWidth="180.0"/>


                  <!-- EMAIL -->

                  <TableColumn
                          fx:id="emailColumn"
                          text="Email"
                          minWidth="200.0"
                          prefWidth="250.0"/>


                  <!-- ADDRESS -->

                  <TableColumn
                          fx:id="addressColumn"
                          text="Address"
                          minWidth="180.0"
                          prefWidth="250.0"/>

               </columns>

            </TableView>

         </VBox>

      </VBox>

   </center>


   <!-- ========================================================= -->
   <!-- BOTTOM ACTION BAR -->
   <!-- ========================================================= -->

   <bottom>

      <HBox
              alignment="CENTER_RIGHT"
              spacing="12.0"
              prefHeight="75.0"
              style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 1 0 0 0;">

         <padding>
            <Insets
                    top="12.0"
                    right="30.0"
                    bottom="12.0"
                    left="30.0"/>
         </padding>


         <Region HBox.hgrow="ALWAYS"/>


         <!-- ================================================= -->
         <!-- ADD CUSTOMER -->
         <!-- ================================================= -->

         <Button
                 mnemonicParsing="false"
                 onAction="#addCustomer"
                 prefHeight="42.0"
                 prefWidth="145.0"
                 text="Add Customer"
                 style="-fx-background-color: #2563EB;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


         <!-- ================================================= -->
         <!-- UPDATE CUSTOMER -->
         <!-- ================================================= -->

         <Button
                 mnemonicParsing="false"
                 onAction="#updateCustomer"
                 prefHeight="42.0"
                 prefWidth="115.0"
                 text="Update"
                 style="-fx-background-color: #16A34A;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


         <!-- ================================================= -->
         <!-- DELETE CUSTOMER -->
         <!-- ================================================= -->

         <Button
                 mnemonicParsing="false"
                 onAction="#deleteCustomer"
                 prefHeight="42.0"
                 prefWidth="110.0"
                 text="Delete"
                 style="-fx-background-color: #DC2626;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


         <!-- ================================================= -->
         <!-- BOOK CUSTOMER -->
         <!-- ================================================= -->

         <Button
                 fx:id="bookSelectedCustomerButton"
                 mnemonicParsing="false"
                 onAction="#bookSelectedCustomer"
                 prefHeight="42.0"
                 prefWidth="190.0"
                 text="Book Selected Customer"
                 style="-fx-background-color: #DB2777;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


         <!-- ================================================= -->
         <!-- BACK -->
         <!-- ================================================= -->

         <Button
                 mnemonicParsing="false"
                 onAction="#backToMain"
                 prefHeight="42.0"
                 prefWidth="100.0"
                 text="Back"
                 style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #334155;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

      </HBox>

   </bottom>

</BorderPane>