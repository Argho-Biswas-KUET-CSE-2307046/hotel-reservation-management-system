<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.FinanceController"

        prefWidth="1200.0"
        prefHeight="800.0"

        minWidth="800.0"
        minHeight="600.0"

        style="-fx-background-color: #F5F7FB;">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <top>

        <VBox
                spacing="5.0"

                minHeight="90.0"

                style="-fx-background-color: #1976D2;">

            <padding>

                <Insets
                        top="20.0"
                        right="25.0"
                        bottom="20.0"
                        left="25.0"/>

            </padding>

            <Label
                    text="FINANCE &amp; REPORTS"
                    wrapText="true"

                    style="-fx-text-fill: white;
                           -fx-font-size: 28px;
                           -fx-font-weight: bold;"/>

            <Label
                    text="Manage expenses, view income and analyze financial transactions"
                    wrapText="true"

                    style="-fx-text-fill: white;
                           -fx-font-size: 14px;"/>

        </VBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="true"

                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"

                style="-fx-background-color: #F5F7FB;
                       -fx-background: #F5F7FB;">

            <content>

                <VBox
                        spacing="15.0"

                        fillWidth="true"

                        maxWidth="Infinity"
                        maxHeight="Infinity"

                        style="-fx-background-color: #F5F7FB;">

                    <padding>

                        <Insets
                                top="15.0"
                                right="20.0"
                                bottom="15.0"
                                left="20.0"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- EXPENSE SECTION -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="10.0"

                            maxWidth="Infinity"

                            style="-fx-background-color: white;
                                   -fx-border-color: #D0D7DE;
                                   -fx-border-radius: 6;
                                   -fx-background-radius: 6;">

                        <padding>

                            <Insets
                                    top="15.0"
                                    right="15.0"
                                    bottom="15.0"
                                    left="15.0"/>

                        </padding>


                        <Label
                                text="Add Expense"
                                style="-fx-font-size: 20px;
                                       -fx-font-weight: bold;
                                       -fx-text-fill: #333333;"/>


                        <!-- RESPONSIVE EXPENSE FORM -->

                        <GridPane
                                hgap="15.0"
                                vgap="10.0"

                                maxWidth="Infinity">

                            <columnConstraints>

                                <javafx.scene.layout.ColumnConstraints
                                        minWidth="80.0"/>

                                <javafx.scene.layout.ColumnConstraints
                                        hgrow="ALWAYS"
                                        fillWidth="true"/>

                                <javafx.scene.layout.ColumnConstraints
                                        minWidth="90.0"/>

                                <javafx.scene.layout.ColumnConstraints
                                        hgrow="ALWAYS"
                                        fillWidth="true"/>

                            </columnConstraints>


                            <Label
                                    text="Date:"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <DatePicker
                                    fx:id="expenseDatePicker"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Amount (৳):"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="expenseAmountField"

                                    promptText="Enter amount"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Reason:"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <TextArea
                                    fx:id="expenseReasonArea"

                                    promptText="Enter expense reason/report"

                                    prefHeight="70.0"

                                    maxWidth="Infinity"

                                    wrapText="true"

                                    GridPane.columnIndex="1"
                                    GridPane.columnSpan="3"
                                    GridPane.rowIndex="1"/>

                        </GridPane>


                        <HBox
                                alignment="CENTER_RIGHT"
                                spacing="10.0">

                            <Button
                                    text="Save Expense"

                                    onAction="#saveExpense"

                                    prefWidth="140.0"
                                    minWidth="120.0"

                                    style="-fx-background-color: #1976D2;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- SUMMARY SECTION -->
                    <!-- ================================================= -->

                    <FlowPane
                            alignment="CENTER"

                            hgap="15.0"
                            vgap="15.0"

                            prefWrapLength="800.0"

                            maxWidth="Infinity">


                        <!-- INCOME -->

                        <VBox
                                alignment="CENTER"

                                minWidth="220.0"
                                prefWidth="250.0"
                                prefHeight="90.0"

                                style="-fx-background-color: #E3F2FD;
                                       -fx-background-radius: 8;">

                            <Label
                                    text="Last 30 Days Income"
                                    wrapText="true"

                                    style="-fx-font-size: 14px;
                                           -fx-text-fill: #555555;"/>

                            <Label
                                    fx:id="last30IncomeLabel"

                                    text="৳ 0.00"

                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #1976D2;"/>

                        </VBox>


                        <!-- EXPENSE -->

                        <VBox
                                alignment="CENTER"

                                minWidth="220.0"
                                prefWidth="250.0"
                                prefHeight="90.0"

                                style="-fx-background-color: #FFF3E0;
                                       -fx-background-radius: 8;">

                            <Label
                                    text="Last 30 Days Expense"
                                    wrapText="true"

                                    style="-fx-font-size: 14px;
                                           -fx-text-fill: #555555;"/>

                            <Label
                                    fx:id="last30ExpenseLabel"

                                    text="৳ 0.00"

                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #E65100;"/>

                        </VBox>


                        <!-- BALANCE -->

                        <VBox
                                alignment="CENTER"

                                minWidth="220.0"
                                prefWidth="250.0"
                                prefHeight="90.0"

                                style="-fx-background-color: #E8F5E9;
                                       -fx-background-radius: 8;">

                            <Label
                                    text="Last 30 Days Balance"
                                    wrapText="true"

                                    style="-fx-font-size: 14px;
                                           -fx-text-fill: #555555;"/>

                            <Label
                                    fx:id="last30BalanceLabel"

                                    text="৳ 0.00"

                                    style="-fx-font-size: 22px;
                                           -fx-font-weight: bold;
                                           -fx-text-fill: #2E7D32;"/>

                        </VBox>

                    </FlowPane>


                    <!-- ================================================= -->
                    <!-- FILTER SECTION -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="10.0"

                            maxWidth="Infinity"

                            style="-fx-background-color: white;
                                   -fx-border-color: #D0D7DE;
                                   -fx-border-radius: 6;
                                   -fx-background-radius: 6;">

                        <padding>

                            <Insets
                                    top="12.0"
                                    right="15.0"
                                    bottom="12.0"
                                    left="15.0"/>

                        </padding>


                        <Label
                                text="Filter Financial Report"

                                style="-fx-font-size: 18px;
                                       -fx-font-weight: bold;"/>


                        <!-- RESPONSIVE FILTER GRID -->

                        <GridPane
                                hgap="12.0"
                                vgap="8.0"

                                maxWidth="Infinity">

                            <columnConstraints>

                                <javafx.scene.layout.ColumnConstraints
                                        minWidth="100.0"/>

                                <javafx.scene.layout.ColumnConstraints
                                        hgrow="ALWAYS"
                                        fillWidth="true"/>

                                <javafx.scene.layout.ColumnConstraints
                                        minWidth="100.0"/>

                                <javafx.scene.layout.ColumnConstraints
                                        hgrow="ALWAYS"
                                        fillWidth="true"/>

                            </columnConstraints>


                            <!-- DATE RANGE -->

                            <Label
                                    text="Min Date:"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <DatePicker
                                    fx:id="minDatePicker"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Max Date:"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <DatePicker
                                    fx:id="maxDatePicker"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- INCOME RANGE -->

                            <Label
                                    text="Min Income (৳):"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="minIncomeField"

                                    promptText="Minimum income"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Max Income (৳):"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="maxIncomeField"

                                    promptText="Maximum income"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- EXPENSE RANGE -->

                            <Label
                                    text="Min Expense (৳):"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <TextField
                                    fx:id="minExpenseField"

                                    promptText="Minimum expense"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Max Expense (৳):"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <TextField
                                    fx:id="maxExpenseField"

                                    promptText="Maximum expense"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>

                        </GridPane>


                        <!-- FILTER BUTTONS -->

                        <FlowPane
                                alignment="CENTER_LEFT"

                                hgap="10.0"
                                vgap="10.0"

                                prefWrapLength="500.0">

                            <Button
                                    text="Apply Filter"

                                    onAction="#applyFilter"

                                    minWidth="120.0"
                                    prefWidth="120.0"/>


                            <Button
                                    text="Clear Filter"

                                    onAction="#clearFilter"

                                    minWidth="120.0"
                                    prefWidth="120.0"/>


                            <Button
                                    text="Last 30 Days"

                                    onAction="#showLast30Days"

                                    minWidth="120.0"
                                    prefWidth="120.0"/>

                        </FlowPane>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- FINANCIAL TABLE -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="8.0"

                            VBox.vgrow="ALWAYS"

                            fillWidth="true"

                            minHeight="350.0"

                            maxWidth="Infinity"
                            maxHeight="Infinity">

                        <Label
                                text="Financial Report"

                                style="-fx-font-size: 20px;
                                       -fx-font-weight: bold;"/>


                        <ScrollPane
                                fitToWidth="true"
                                fitToHeight="true"

                                hbarPolicy="AS_NEEDED"
                                vbarPolicy="AS_NEEDED"

                                VBox.vgrow="ALWAYS"

                                style="-fx-background-color: transparent;
                                       -fx-background: transparent;">

                            <content>

                                <TableView
                                        fx:id="financialTable"

                                        minWidth="850.0"
                                        minHeight="300.0"

                                        maxWidth="Infinity"
                                        maxHeight="Infinity"

                                        style="-fx-background-color: white;">

                                    <columns>

                                        <TableColumn
                                                fx:id="dateColumn"

                                                text="Date"

                                                minWidth="100.0"
                                                prefWidth="120.0"/>


                                        <TableColumn
                                                fx:id="incomeColumn"

                                                text="Income (৳)"

                                                minWidth="110.0"
                                                prefWidth="130.0"/>


                                        <TableColumn
                                                fx:id="incomeReasonColumn"

                                                text="Reason of Income"

                                                minWidth="220.0"
                                                prefWidth="280.0"/>


                                        <TableColumn
                                                fx:id="expenseColumn"

                                                text="Expense (৳)"

                                                minWidth="110.0"
                                                prefWidth="130.0"/>


                                        <TableColumn
                                                fx:id="expenseReasonColumn"

                                                text="Reason of Expense"

                                                minWidth="220.0"
                                                prefWidth="280.0"/>

                                    </columns>

                                </TableView>

                            </content>

                        </ScrollPane>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- BOTTOM TOTAL -->
                    <!-- ================================================= -->

                    <FlowPane
                            alignment="CENTER"

                            hgap="20.0"
                            vgap="10.0"

                            prefWrapLength="800.0"

                            maxWidth="Infinity">

                        <Label
                                text="Selected Range Income:"
                                style="-fx-font-weight: bold;"/>

                        <Label
                                fx:id="filteredIncomeLabel"

                                text="৳ 0.00"

                                style="-fx-font-weight: bold;
                                       -fx-text-fill: #1976D2;"/>


                        <Label
                                text="Selected Range Expense:"
                                style="-fx-font-weight: bold;"/>

                        <Label
                                fx:id="filteredExpenseLabel"

                                text="৳ 0.00"

                                style="-fx-font-weight: bold;
                                       -fx-text-fill: #E65100;"/>


                        <Label
                                text="Balance:"
                                style="-fx-font-weight: bold;"/>

                        <Label
                                fx:id="filteredBalanceLabel"

                                text="৳ 0.00"

                                style="-fx-font-weight: bold;
                                       -fx-text-fill: #2E7D32;"/>

                    </FlowPane>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM CHART -->
    <!-- ========================================================= -->

    <bottom>

        <VBox
                spacing="8.0"

                maxWidth="Infinity">

            <padding>

                <Insets
                        top="10.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>

            </padding>


            <Label
                    text="Income vs Expense"

                    style="-fx-font-size: 20px;
                           -fx-font-weight: bold;"/>


            <BarChart
                    fx:id="financialChart"

                    prefHeight="250.0"

                    minHeight="180.0"

                    maxWidth="Infinity"

                    animated="false"
                    legendVisible="true">

                <xAxis>

                    <CategoryAxis
                            fx:id="chartXAxis"
                            label="Date"/>

                </xAxis>


                <yAxis>

                    <NumberAxis
                            fx:id="chartYAxis"
                            label="Amount (৳)"
                            forceZeroInRange="true"/>

                </yAxis>

            </BarChart>

        </VBox>

    </bottom>

</BorderPane>