<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.WeatherController"

        prefWidth="1100.0"
        prefHeight="750.0"

        minWidth="800.0"
        minHeight="600.0"

        style="-fx-background-color: #F5F7FB;">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="15.0"

                minHeight="75.0"
                prefHeight="90.0"

                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 0 0 1 0;">

            <padding>

                <Insets
                        top="15.0"
                        right="30.0"
                        bottom="15.0"
                        left="30.0"/>

            </padding>


            <VBox
                    spacing="3.0"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="WEATHER INFORMATION"
                        textFill="#1E3A8A"
                        wrapText="true">

                    <font>

                        <Font
                                name="System Bold"
                                size="26.0"/>

                    </font>

                </Label>


                <Label
                        text="7-day weather forecast and live weather information"
                        textFill="#64748B"
                        wrapText="true">

                    <font>

                        <Font
                                name="System"
                                size="13.0"/>

                    </font>

                </Label>

            </VBox>


            <Region
                    minWidth="10.0"
                    HBox.hgrow="ALWAYS"/>


            <Label
                    text="LIVE DATA"
                    textFill="#16A34A">

                <font>

                    <Font
                            name="System Bold"
                            size="14.0"/>

                </font>

            </Label>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="true"

                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"

                style="-fx-background-color: #F5F7FB;
                       -fx-border-color: transparent;">

            <content>

                <VBox
                        alignment="TOP_CENTER"
                        spacing="20.0"

                        fillWidth="true"

                        maxWidth="Infinity"

                        style="-fx-background-color: #F5F7FB;">

                    <padding>

                        <Insets
                                top="30.0"
                                right="40.0"
                                bottom="30.0"
                                left="40.0"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- SEARCH CARD -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="12.0"

                            maxWidth="900.0"

                            style="-fx-background-color: #DBEAFE;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #93C5FD;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 20;">

                        <Label
                                text="Search Weather"
                                textFill="#1E3A8A">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="19.0"/>

                            </font>

                        </Label>


                        <Label
                                text="Enter a city name to retrieve its current weather and 7-day forecast."
                                textFill="#475569"
                                wrapText="true">

                            <font>

                                <Font
                                        name="System"
                                        size="13.0"/>

                            </font>

                        </Label>


                        <!-- RESPONSIVE SEARCH AREA -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12.0">

                            <TextField
                                    fx:id="cityField"

                                    prefHeight="42.0"

                                    promptText="Enter city name"

                                    maxWidth="Infinity"

                                    HBox.hgrow="ALWAYS"

                                    style="-fx-background-color: #FFFFFF;
                                           -fx-border-color: #CBD5E1;
                                           -fx-border-width: 1;
                                           -fx-background-radius: 8;
                                           -fx-border-radius: 8;
                                           -fx-padding: 8 12 8 12;
                                           -fx-font-size: 13px;"/>


                            <Button
                                    fx:id="refreshWeatherButton"

                                    mnemonicParsing="false"

                                    onAction="#refreshWeather"

                                    prefHeight="42.0"

                                    minWidth="150.0"
                                    prefWidth="180.0"

                                    text="Refresh Weather"

                                    style="-fx-background-color: #2563EB;
                                           -fx-text-fill: white;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- CURRENT WEATHER CARD -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="18.0"

                            maxWidth="900.0"

                            style="-fx-background-color: #FFFFFF;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 25;">


                        <!-- CURRENT WEATHER HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10.0">

                            <VBox
                                    spacing="4.0"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Current Weather"
                                        textFill="#172554"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="22.0"/>

                                    </font>

                                </Label>


                                <Label
                                        text="Live information received from an online API"
                                        textFill="#64748B"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System"
                                                size="13.0"/>

                                    </font>

                                </Label>

                            </VBox>


                            <Region
                                    minWidth="10.0"
                                    HBox.hgrow="ALWAYS"/>


                            <Label
                                    text="ONLINE API"
                                    textFill="#2563EB">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="12.0"/>

                                </font>

                            </Label>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- CITY -->
                        <!-- ================================================= -->

                        <VBox
                                alignment="CENTER"
                                spacing="5.0"

                                maxWidth="Infinity"

                                style="-fx-background-color: #EFF6FF;
                                       -fx-background-radius: 10;
                                       -fx-padding: 18;">

                            <Label
                                    text="CITY"
                                    textFill="#64748B">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="11.0"/>

                                </font>

                            </Label>


                            <Label
                                    fx:id="cityLabel"
                                    text="--"
                                    textFill="#1E3A8A"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="25.0"/>

                                </font>

                            </Label>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- CURRENT WEATHER VALUES -->
                        <!-- ================================================= -->

                        <FlowPane
                                alignment="CENTER"

                                hgap="15.0"
                                vgap="15.0"

                                prefWrapLength="650.0"

                                maxWidth="Infinity">


                            <!-- TEMPERATURE -->

                            <VBox
                                    alignment="CENTER"
                                    spacing="7.0"

                                    minWidth="190.0"
                                    prefWidth="210.0"
                                    minHeight="110.0"
                                    prefHeight="125.0"

                                    style="-fx-background-color: #FEF3C7;
                                           -fx-background-radius: 10;
                                           -fx-padding: 20;">

                                <Label
                                        text="TEMPERATURE"
                                        textFill="#92400E">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="11.0"/>

                                    </font>

                                </Label>


                                <Label
                                        fx:id="temperatureLabel"
                                        text="-- °C"
                                        textFill="#B45309"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="24.0"/>

                                    </font>

                                </Label>

                            </VBox>


                            <!-- HUMIDITY -->

                            <VBox
                                    alignment="CENTER"
                                    spacing="7.0"

                                    minWidth="190.0"
                                    prefWidth="210.0"
                                    minHeight="110.0"
                                    prefHeight="125.0"

                                    style="-fx-background-color: #DBEAFE;
                                           -fx-background-radius: 10;
                                           -fx-padding: 20;">

                                <Label
                                        text="HUMIDITY"
                                        textFill="#1E40AF">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="11.0"/>

                                    </font>

                                </Label>


                                <Label
                                        fx:id="humidityLabel"
                                        text="--%"
                                        textFill="#2563EB"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="24.0"/>

                                    </font>

                                </Label>

                            </VBox>


                            <!-- CONDITION -->

                            <VBox
                                    alignment="CENTER"
                                    spacing="7.0"

                                    minWidth="190.0"
                                    prefWidth="210.0"
                                    minHeight="110.0"
                                    prefHeight="125.0"

                                    style="-fx-background-color: #DCFCE7;
                                           -fx-background-radius: 10;
                                           -fx-padding: 20;">

                                <Label
                                        text="CONDITION"
                                        textFill="#166534">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="11.0"/>

                                    </font>

                                </Label>


                                <Label
                                        fx:id="conditionLabel"
                                        text="--"
                                        textFill="#15803D"

                                        wrapText="true"
                                        alignment="CENTER">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="18.0"/>

                                    </font>

                                </Label>

                            </VBox>

                        </FlowPane>


                        <!-- ================================================= -->
                        <!-- 7-DAY FORECAST -->
                        <!-- ================================================= -->

                        <VBox
                                spacing="12.0"

                                maxWidth="Infinity"

                                style="-fx-background-color: #F8FAFC;
                                       -fx-background-radius: 10;
                                       -fx-padding: 18;">


                            <!-- FORECAST HEADER -->

                            <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="10.0">

                                <VBox
                                        spacing="3.0"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS">

                                    <Label
                                            text="7-DAY FORECAST"
                                            textFill="#172554">

                                        <font>

                                            <Font
                                                    name="System Bold"
                                                    size="18.0"/>

                                        </font>

                                    </Label>


                                    <Label
                                            text="Daily temperature and weather conditions"
                                            textFill="#64748B"
                                            wrapText="true">

                                        <font>

                                            <Font
                                                    name="System"
                                                    size="12.0"/>

                                        </font>

                                    </Label>

                                </VBox>


                                <Region
                                        minWidth="10.0"
                                        HBox.hgrow="ALWAYS"/>


                                <Label
                                        text="NEXT 7 DAYS"
                                        textFill="#2563EB">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="11.0"/>

                                    </font>

                                </Label>

                            </HBox>


                            <!-- ================================================= -->
                            <!-- FORECAST SCROLL AREA -->
                            <!-- ================================================= -->

                            <ScrollPane
                                    fitToHeight="false"
                                    fitToWidth="false"

                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"

                                    prefHeight="280.0"
                                    minHeight="280.0"

                                    style="-fx-background-color: transparent;
                                           -fx-border-color: transparent;">

                                <content>

                                    <HBox
                                            fx:id="forecastContainer"

                                            alignment="TOP_LEFT"
                                            spacing="12.0"

                                            prefHeight="250.0"
                                            minHeight="250.0"

                                            style="-fx-background-color: transparent;"/>

                                </content>

                            </ScrollPane>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- STATUS -->
                        <!-- ================================================= -->

                        <HBox
                                alignment="CENTER"

                                maxWidth="Infinity"

                                style="-fx-background-color: #F8FAFC;
                                       -fx-background-radius: 8;
                                       -fx-padding: 12;">

                            <Label
                                    fx:id="statusLabel"
                                    text="Loading weather information..."
                                    textFill="#64748B"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="12.0"/>

                                </font>

                            </Label>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM -->
    <!-- ========================================================= -->

    <bottom>

        <HBox
                alignment="CENTER_RIGHT"
                spacing="12.0"

                minHeight="65.0"
                prefHeight="70.0"

                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 1 0 0 0;">

            <padding>

                <Insets
                        top="12.0"
                        right="30.0"
                        bottom="12.0"
                        left="30.0"/>

            </padding>


            <Region
                    minWidth="10.0"
                    HBox.hgrow="ALWAYS"/>


            <!-- BACK BUTTON -->

            <Button
                    mnemonicParsing="false"

                    onAction="#backToMain"

                    prefHeight="42.0"

                    minWidth="90.0"
                    prefWidth="100.0"

                    text="Back"

                    style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #334155;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>