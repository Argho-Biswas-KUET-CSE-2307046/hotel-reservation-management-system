<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.BookingController"

        prefWidth="1100.0"
        prefHeight="750.0"

        minWidth="850.0"
        minHeight="650.0"

        style="-fx-background-color: #F5F7FB;">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <top>

        <VBox
                spacing="0.0"
                fillWidth="true">

            <!-- HEADER -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15.0"

                    minHeight="75.0"
                    prefHeight="90.0"

                    maxWidth="Infinity"

                    style="-fx-background-color: #FFFFFF;
                           -fx-border-color: #E2E8F0;
                           -fx-border-width: 0 0 1 0;">

                <padding>

                    <Insets
                            top="15.0"
                            right="30.0"
                            bottom="15.0"
                            left="30.0"/>

                </padding>


                <!-- TITLE -->

                <VBox
                        spacing="3.0"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="BOOKING MANAGEMENT"
                            textFill="#1E3A8A"
                            wrapText="true">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="26.0"/>

                        </font>

                    </Label>


                    <Label
                            text="Create and manage hotel reservations"
                            textFill="#64748B"
                            wrapText="true">

                        <font>

                            <Font
                                    name="System"
                                    size="13.0"/>

                        </font>

                    </Label>

                </VBox>


                <Region
                        minWidth="10.0"
                        HBox.hgrow="ALWAYS"/>


                <!-- SELECTED CUSTOMER -->

                <VBox
                        alignment="CENTER_RIGHT"
                        spacing="5.0"
                        maxWidth="300.0">

                    <Label
                            text="SELECTED CUSTOMER"
                            textFill="#64748B"
                            wrapText="true">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="11.0"/>

                        </font>

                    </Label>


                    <Label
                            fx:id="selectedCustomerLabel"
                            text="No customer selected"
                            textFill="#2563EB"
                            wrapText="true">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="14.0"/>

                        </font>

                    </Label>

                </VBox>

            </HBox>


            <!-- ===================================================== -->
            <!-- BOOKING PROGRESS -->
            <!-- ===================================================== -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="12.0"

                    minHeight="55.0"
                    prefHeight="60.0"

                    maxWidth="Infinity"

                    style="-fx-background-color: #FFFFFF;">

                <padding>

                    <Insets
                            top="8.0"
                            right="30.0"
                            bottom="8.0"
                            left="30.0"/>

                </padding>


                <Label
                        text="Booking Progress"
                        textFill="#475569">

                    <font>

                        <Font
                                name="System Bold"
                                size="13.0"/>

                    </font>

                </Label>


                <!-- RESPONSIVE PROGRESS BAR -->

                <ProgressBar
                        fx:id="bookingProgressBar"

                        progress="0.0"

                        prefWidth="350.0"
                        minWidth="180.0"

                        maxWidth="600.0"

                        HBox.hgrow="ALWAYS"/>

            </HBox>

        </VBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="true"

                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"

                pannable="true"

                style="-fx-background-color: #F5F7FB;
                       -fx-background: #F5F7FB;">

            <content>

                <VBox
                        spacing="18.0"

                        fillWidth="true"

                        maxWidth="Infinity"
                        maxHeight="Infinity"

                        style="-fx-background-color: #F5F7FB;">

                    <padding>

                        <Insets
                                top="25.0"
                                right="30.0"
                                bottom="25.0"
                                left="30.0"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- ROOM FILTER CARD -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="12.0"

                            fillWidth="true"

                            maxWidth="Infinity"

                            style="-fx-background-color: #DBEAFE;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #93C5FD;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 20;">

                        <Label
                                text="Room Selection"
                                textFill="#1E3A8A"
                                wrapText="true">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="19.0"/>

                            </font>

                        </Label>


                        <!-- RESPONSIVE ROOM FILTER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="15.0"

                                fillHeight="true">

                            <Label
                                    fx:id="roomPriceLabel"
                                    text="Room Price Range"
                                    textFill="#334155"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Slider
                                    fx:id="roomPriceSlider"

                                    min="1000.0"
                                    max="5000.0"
                                    value="2500.0"

                                    prefWidth="350.0"
                                    minWidth="180.0"
                                    maxWidth="600.0"

                                    HBox.hgrow="ALWAYS"/>


                            <Label
                                    text="Guests"
                                    textFill="#334155">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Spinner
                                    fx:id="guestSpinner"

                                    prefWidth="100.0"
                                    minWidth="80.0"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- BOOKING FORM CARD -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="15.0"

                            fillWidth="true"

                            maxWidth="Infinity"

                            style="-fx-background-color: #FFFFFF;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 22;">

                        <VBox
                                spacing="3.0"
                                maxWidth="Infinity">

                            <Label
                                    text="Reservation Details"
                                    textFill="#172554"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="21.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Select the customer, room and reservation preferences."
                                    textFill="#64748B"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- RESPONSIVE FORM GRID -->
                        <!-- ================================================= -->

                        <GridPane
                                hgap="20.0"
                                vgap="14.0"

                                maxWidth="Infinity">

                            <padding>

                                <Insets
                                        top="5.0"
                                        right="10.0"
                                        bottom="5.0"
                                        left="10.0"/>

                            </padding>


                            <!-- RESPONSIVE COLUMNS -->

                            <columnConstraints>

                                <!-- LABEL COLUMN -->

                                <ColumnConstraints
                                        percentWidth="20.0"
                                        minWidth="120.0"
                                        hgrow="NEVER"
                                        halignment="RIGHT"/>


                                <!-- CONTROL COLUMN -->

                                <ColumnConstraints
                                        percentWidth="40.0"
                                        minWidth="200.0"
                                        hgrow="ALWAYS"/>


                                <!-- EXTRA SPACE COLUMN -->

                                <ColumnConstraints
                                        percentWidth="40.0"
                                        minWidth="150.0"
                                        hgrow="ALWAYS"/>

                            </columnConstraints>


                            <!-- RESPONSIVE ROWS -->

                            <rowConstraints>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="42.0"
                                        vgrow="SOMETIMES"/>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="42.0"
                                        vgrow="SOMETIMES"/>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="42.0"
                                        vgrow="SOMETIMES"/>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="42.0"
                                        vgrow="SOMETIMES"/>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="42.0"
                                        vgrow="SOMETIMES"/>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="42.0"
                                        vgrow="SOMETIMES"/>

                            </rowConstraints>


                            <!-- ================================================= -->
                            <!-- CUSTOMER -->
                            <!-- ================================================= -->

                            <Label
                                    text="Customer:"
                                    textFill="#334155"

                                    GridPane.rowIndex="0">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <ComboBox
                                    fx:id="customerComboBox"

                                    prefWidth="240.0"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- ================================================= -->
                            <!-- ROOM -->
                            <!-- ================================================= -->

                            <Label
                                    text="Room:"
                                    textFill="#334155"

                                    GridPane.rowIndex="1">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <ComboBox
                                    fx:id="roomComboBox"

                                    prefWidth="240.0"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <!-- ================================================= -->
                            <!-- CHECK IN -->
                            <!-- ================================================= -->

                            <Label
                                    text="Check-in:"
                                    textFill="#334155"

                                    GridPane.rowIndex="2">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <DatePicker
                                    fx:id="checkInDatePicker"

                                    prefWidth="240.0"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <!-- ================================================= -->
                            <!-- CHECK OUT -->
                            <!-- ================================================= -->

                            <Label
                                    text="Check-out:"
                                    textFill="#334155"

                                    GridPane.rowIndex="3">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <DatePicker
                                    fx:id="checkOutDatePicker"

                                    prefWidth="240.0"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>


                            <!-- ================================================= -->
                            <!-- BOOKING TYPE -->
                            <!-- ================================================= -->

                            <Label
                                    text="Booking Type:"
                                    textFill="#334155"

                                    GridPane.rowIndex="4">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="25.0"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4">

                                <RadioButton
                                        fx:id="regularRadioButton"

                                        mnemonicParsing="false"

                                        text="Regular"
                                        textFill="#334155">

                                    <toggleGroup>

                                        <ToggleGroup
                                                fx:id="bookingTypeGroup"/>

                                    </toggleGroup>

                                </RadioButton>


                                <RadioButton
                                        fx:id="vipRadioButton"

                                        mnemonicParsing="false"

                                        text="VIP"
                                        textFill="#BE185D"

                                        toggleGroup="$bookingTypeGroup"/>

                            </HBox>


                            <!-- ================================================= -->
                            <!-- EXTRA SERVICES -->
                            <!-- ================================================= -->

                            <Label
                                    text="Extra Services:"
                                    textFill="#334155"

                                    GridPane.rowIndex="5">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="25.0"

                                    maxWidth="Infinity"

                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="5">

                                <CheckBox
                                        fx:id="breakfastCheckBox"

                                        mnemonicParsing="false"

                                        text="Breakfast"
                                        textFill="#15803D"/>


                                <CheckBox
                                        fx:id="airportPickupCheckBox"

                                        mnemonicParsing="false"

                                        text="Airport Pickup"
                                        textFill="#2563EB"/>

                            </HBox>

                        </GridPane>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- BOOKING TABLE CARD -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="12.0"

                            fillWidth="true"

                            VBox.vgrow="ALWAYS"

                            maxWidth="Infinity"
                            maxHeight="Infinity"

                            minHeight="350.0"

                            style="-fx-background-color: #FFFFFF;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 20;">

                        <!-- TABLE HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10.0">

                            <VBox
                                    spacing="3.0"
                                    maxWidth="Infinity">

                                <Label
                                        text="Booking Records"
                                        textFill="#172554"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="21.0"/>

                                    </font>

                                </Label>


                                <Label
                                        text="View current reservations"
                                        textFill="#64748B"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System"
                                                size="13.0"/>

                                    </font>

                                </Label>

                            </VBox>


                            <Region
                                    minWidth="10.0"
                                    HBox.hgrow="ALWAYS"/>


                            <Label
                                    text="RESERVATIONS"
                                    textFill="#16A34A">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="12.0"/>

                                </font>

                            </Label>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- RESPONSIVE BOOKING TABLE -->
                        <!-- ================================================= -->

                        <TableView
                                fx:id="bookingTable"

                                prefHeight="280.0"

                                minHeight="220.0"
                                minWidth="700.0"

                                maxWidth="Infinity"
                                maxHeight="Infinity"

                                VBox.vgrow="ALWAYS"

                                style="-fx-background-color: #FFFFFF;
                                       -fx-border-color: #CBD5E1;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;">

                            <columns>

                                <TableColumn
                                        fx:id="bookingIdColumn"

                                        minWidth="80.0"
                                        prefWidth="100.0"

                                        text="Booking ID"/>


                                <TableColumn
                                        fx:id="customerColumn"

                                        minWidth="140.0"
                                        prefWidth="180.0"

                                        text="Customer"/>


                                <TableColumn
                                        fx:id="roomColumn"

                                        minWidth="110.0"
                                        prefWidth="160.0"

                                        text="Room"/>


                                <TableColumn
                                        fx:id="checkInColumn"

                                        minWidth="120.0"
                                        prefWidth="160.0"

                                        text="Check In"/>


                                <TableColumn
                                        fx:id="checkOutColumn"

                                        minWidth="120.0"
                                        prefWidth="160.0"

                                        text="Check Out"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM RESPONSIVE ACTION BAR -->
    <!-- ========================================================= -->

    <bottom>

        <FlowPane
                alignment="CENTER_RIGHT"

                hgap="12.0"
                vgap="10.0"

                prefHeight="75.0"
                minHeight="65.0"

                prefWrapLength="700.0"

                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 1 0 0 0;">

            <padding>

                <Insets
                        top="12.0"
                        right="30.0"
                        bottom="12.0"
                        left="30.0"/>

            </padding>


            <!-- ADD BOOKING -->

            <Button
                    mnemonicParsing="false"

                    onAction="#addBooking"

                    prefHeight="42.0"
                    minWidth="110.0"
                    prefWidth="140.0"

                    text="Add Booking"

                    style="-fx-background-color: #2563EB;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- UPDATE -->

            <Button
                    mnemonicParsing="false"

                    onAction="#updateBooking"

                    prefHeight="42.0"
                    minWidth="100.0"
                    prefWidth="120.0"

                    text="Update"

                    style="-fx-background-color: #16A34A;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- DELETE -->

            <Button
                    mnemonicParsing="false"

                    onAction="#deleteBooking"

                    prefHeight="42.0"
                    minWidth="100.0"
                    prefWidth="120.0"

                    text="Delete"

                    style="-fx-background-color: #DC2626;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- BACK -->

            <Button
                    mnemonicParsing="false"

                    onAction="#backToMain"

                    prefHeight="42.0"
                    minWidth="80.0"
                    prefWidth="100.0"

                    text="Back"

                    style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #334155;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </FlowPane>

    </bottom>

</BorderPane>