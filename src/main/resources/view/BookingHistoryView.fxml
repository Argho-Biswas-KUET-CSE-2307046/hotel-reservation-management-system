<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.BookingHistoryController"

        prefWidth="1100.0"
        prefHeight="700.0"

        minWidth="800.0"
        minHeight="600.0"

        style="-fx-background-color: #F5F7FB;">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="15.0"

                minHeight="75.0"
                prefHeight="90.0"

                maxWidth="Infinity"

                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 0 0 1 0;">

            <padding>

                <Insets
                        top="15.0"
                        right="30.0"
                        bottom="15.0"
                        left="30.0"/>

            </padding>


            <!-- ================================================= -->
            <!-- HEADER TITLE -->
            <!-- ================================================= -->

            <VBox
                    spacing="3.0"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="BOOKING HISTORY"
                        textFill="#1E3A8A"
                        wrapText="true">

                    <font>

                        <Font
                                name="System Bold"
                                size="26.0"/>

                    </font>

                </Label>


                <Label
                        text="View and manage previous hotel reservations"
                        textFill="#64748B"
                        wrapText="true"
                        maxWidth="Infinity">

                    <font>

                        <Font
                                name="System"
                                size="13.0"/>

                    </font>

                </Label>

            </VBox>


            <Region
                    minWidth="10.0"
                    HBox.hgrow="ALWAYS"/>


            <Label
                    text="RESERVATION RECORDS"
                    textFill="#F97316"
                    wrapText="true">

                <font>

                    <Font
                            name="System Bold"
                            size="14.0"/>

                </font>

            </Label>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="true"

                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"

                pannable="true"

                style="-fx-background-color: #F5F7FB;
                       -fx-background: #F5F7FB;">

            <content>

                <VBox
                        spacing="18.0"

                        fillWidth="true"

                        maxWidth="Infinity"
                        maxHeight="Infinity"

                        style="-fx-background-color: #F5F7FB;">

                    <padding>

                        <Insets
                                top="25.0"
                                right="30.0"
                                bottom="20.0"
                                left="30.0"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- INFORMATION CARD -->
                    <!-- ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="15.0"

                            minHeight="95.0"
                            maxWidth="Infinity"

                            style="-fx-background-color: #FFF7ED;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #FED7AA;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 20;">

                        <VBox
                                spacing="5.0"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Reservation Overview"
                                    textFill="#7C2D12"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="20.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Review customer, room and check-in/check-out information from previous bookings."
                                    textFill="#7C5B45"
                                    wrapText="true"
                                    maxWidth="Infinity">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>

                        </VBox>


                        <Region
                                minWidth="10.0"
                                HBox.hgrow="ALWAYS"/>


                        <Label
                                text="HISTORY"
                                textFill="#EA580C">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="12.0"/>

                            </font>

                        </Label>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- BOOKING HISTORY TABLE CARD -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="12.0"

                            fillWidth="true"

                            VBox.vgrow="ALWAYS"

                            maxWidth="Infinity"
                            maxHeight="Infinity"

                            minHeight="400.0"

                            style="-fx-background-color: #FFFFFF;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 20;">

                        <!-- TABLE HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10.0">

                            <VBox
                                    spacing="3.0"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Reservation Records"
                                        textFill="#172554"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System Bold"
                                                size="21.0"/>

                                    </font>

                                </Label>


                                <Label
                                        text="Complete booking history"
                                        textFill="#64748B"
                                        wrapText="true">

                                    <font>

                                        <Font
                                                name="System"
                                                size="13.0"/>

                                    </font>

                                </Label>

                            </VBox>


                            <Region
                                    minWidth="10.0"
                                    HBox.hgrow="ALWAYS"/>


                            <Label
                                    text="BOOKINGS"
                                    textFill="#F97316">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="12.0"/>

                                </font>

                            </Label>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- RESPONSIVE TABLE AREA -->
                        <!-- ================================================= -->

                        <ScrollPane
                                fitToWidth="true"
                                fitToHeight="true"

                                hbarPolicy="AS_NEEDED"
                                vbarPolicy="AS_NEEDED"

                                VBox.vgrow="ALWAYS"

                                style="-fx-background-color: transparent;
                                       -fx-background: transparent;
                                       -fx-padding: 0;">

                            <content>

                                <TableView
                                        fx:id="bookingHistoryTable"

                                        prefHeight="450.0"

                                        minWidth="750.0"
                                        minHeight="300.0"

                                        maxWidth="Infinity"
                                        maxHeight="Infinity"

                                        style="-fx-background-color: #FFFFFF;
                                               -fx-border-color: #CBD5E1;
                                               -fx-border-radius: 8;
                                               -fx-background-radius: 8;
                                               -fx-fixed-cell-size: 48px;">

                                    <columns>

                                        <!-- BOOKING ID -->

                                        <TableColumn
                                                fx:id="bookingIdColumn"

                                                minWidth="100.0"
                                                prefWidth="140.0"

                                                text="Booking ID"/>


                                        <!-- CUSTOMER -->

                                        <TableColumn
                                                fx:id="customerColumn"

                                                minWidth="180.0"
                                                prefWidth="260.0"

                                                text="Customer"/>


                                        <!-- ROOM -->

                                        <TableColumn
                                                fx:id="roomColumn"

                                                minWidth="170.0"
                                                prefWidth="240.0"

                                                text="Room"/>


                                        <!-- CHECK IN -->

                                        <TableColumn
                                                fx:id="checkInColumn"

                                                minWidth="150.0"
                                                prefWidth="190.0"

                                                text="Check In"/>


                                        <!-- CHECK OUT -->

                                        <TableColumn
                                                fx:id="checkOutColumn"

                                                minWidth="150.0"
                                                prefWidth="190.0"

                                                text="Check Out"/>

                                    </columns>

                                </TableView>

                            </content>

                        </ScrollPane>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM ACTION BAR -->
    <!-- ========================================================= -->

    <bottom>

        <FlowPane
                alignment="CENTER_RIGHT"

                hgap="12.0"
                vgap="10.0"

                prefHeight="75.0"
                minHeight="65.0"

                prefWrapLength="500.0"

                maxWidth="Infinity"

                style="-fx-background-color: #FFFFFF;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 1 0 0 0;">

            <padding>

                <Insets
                        top="12.0"
                        right="30.0"
                        bottom="12.0"
                        left="30.0"/>

            </padding>


            <!-- BACK BUTTON -->

            <Button
                    mnemonicParsing="false"

                    onAction="#backToMain"

                    prefHeight="42.0"

                    minWidth="90.0"
                    prefWidth="110.0"

                    text="Back"

                    style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #334155;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </FlowPane>

    </bottom>

</BorderPane>