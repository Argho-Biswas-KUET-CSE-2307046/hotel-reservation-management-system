<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="hotel.controller.MainController"
        prefWidth="1100.0"
        prefHeight="700.0"
        minWidth="900.0"
        minHeight="600.0"
        style="-fx-background-color: #F5F7FB;">

    <!-- ========================================================= -->
    <!-- CSS -->
    <!-- ========================================================= -->

    <stylesheets>
        <String fx:value="@../css/style.css"/>
    </stylesheets>


    <!-- ========================================================= -->
    <!-- TOP SECTION -->
    <!-- ========================================================= -->

    <top>

        <VBox spacing="0">

            <!-- MENU BAR -->

            <MenuBar
                    style="-fx-background-color: #FFFFFF;
                           -fx-border-color: #E5E7EB;
                           -fx-border-width: 0 0 1 0;">

                <menus>

                    <Menu
                            mnemonicParsing="false"
                            text="File">

                        <items>

                            <MenuItem
                                    mnemonicParsing="false"
                                    onAction="#newAction"
                                    text="New"/>

                            <MenuItem
                                    mnemonicParsing="false"
                                    onAction="#openAction"
                                    text="Open"/>

                            <MenuItem
                                    mnemonicParsing="false"
                                    onAction="#exitApplication"
                                    text="Exit"/>

                        </items>

                    </Menu>

                </menus>

            </MenuBar>


            <!-- HEADER -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15.0"
                    prefHeight="85.0"
                    style="-fx-background-color: #FFFFFF;
                           -fx-border-color: #E5E7EB;
                           -fx-border-width: 0 0 1 0;">

                <padding>

                    <Insets
                            top="15.0"
                            right="30.0"
                            bottom="15.0"
                            left="30.0"/>

                </padding>


                <VBox spacing="3.0">

                    <Label
                            text="HOTEL RESERVATION"
                            textFill="#1E3A8A">

                        <font>

                            <Font
                                    name="System Bold"
                                    size="24.0"/>

                        </font>

                    </Label>


                    <Label
                            text="AND MANAGEMENT SYSTEM"
                            textFill="#64748B">

                        <font>

                            <Font
                                    name="System"
                                    size="13.0"/>

                        </font>

                    </Label>

                </VBox>


                <Region
                        HBox.hgrow="ALWAYS"/>


                <Label
                        text="Dashboard"
                        textFill="#2563EB">

                    <font>

                        <Font
                                name="System Bold"
                                size="15.0"/>

                    </font>

                </Label>

            </HBox>

        </VBox>

    </top>


    <!-- ========================================================= -->
    <!-- LEFT SIDEBAR -->
    <!-- ========================================================= -->

    <left>

        <VBox
                prefWidth="235.0"
                spacing="12.0"
                alignment="TOP_CENTER"
                style="-fx-background-color: #172554;">

            <padding>

                <Insets
                        top="30.0"
                        right="18.0"
                        bottom="25.0"
                        left="18.0"/>

            </padding>


            <!-- HOTEL -->

            <Label
                    text="HOTEL"
                    textFill="WHITE">

                <font>

                    <Font
                            name="System Bold"
                            size="26.0"/>

                </font>

            </Label>


            <Label
                    text="MANAGEMENT SYSTEM"
                    textFill="#BFDBFE">

                <font>

                    <Font
                            name="System"
                            size="12.0"/>

                </font>

            </Label>


            <Region
                    prefHeight="15.0"/>


            <!-- DASHBOARD -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    text="Dashboard"
                    style="-fx-background-color: #2563EB;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- ROOM MANAGEMENT -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    onAction="#openRoomManagement"
                    text="Room Management"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #E0E7FF;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- CUSTOMER MANAGEMENT -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    onAction="#openCustomerManagement"
                    text="Customer Management"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #E0E7FF;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- BOOKING -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    onAction="#openBooking"
                    text="Booking"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #E0E7FF;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- BOOKING HISTORY -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    onAction="#openBookingHistory"
                    text="Booking History"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #E0E7FF;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- FINANCE & REPORTS -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    onAction="#openFinance"
                    text="Finance &amp; Reports"
                    style="-fx-background-color: #7C3AED;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- WEATHER INFORMATION -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="48.0"
                    mnemonicParsing="false"
                    onAction="#openWeather"
                    text="Weather Information"
                    style="-fx-background-color: #0EA5E9;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <Region
                    VBox.vgrow="ALWAYS"/>


            <!-- EXIT -->

            <Button
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    mnemonicParsing="false"
                    onAction="#exitApplication"
                    text="Exit"
                    style="-fx-background-color: #1E40AF;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </VBox>

    </left>


    <!-- ========================================================= -->
    <!-- CENTER DASHBOARD -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: #F5F7FB;
                       -fx-background: #F5F7FB;">

            <content>

                <VBox
                        spacing="22.0"
                        fillWidth="true"
                        style="-fx-background-color: #F5F7FB;">

                    <padding>

                        <Insets
                                top="30.0"
                                right="35.0"
                                bottom="30.0"
                                left="35.0"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- DASHBOARD TITLE -->
                    <!-- ================================================= -->

                    <VBox spacing="5.0">

                        <Label
                                text="Dashboard Overview"
                                textFill="#172554">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="28.0"/>

                            </font>

                        </Label>


                        <Label
                                text="Manage your hotel rooms, customers and reservations from one place."
                                textFill="#64748B"
                                wrapText="true">

                            <font>

                                <Font
                                        name="System"
                                        size="15.0"/>

                            </font>

                        </Label>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- THREE INFORMATION CARDS -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="18.0"
                            fillHeight="true">


                        <!-- ROOM CARD -->

                        <VBox
                                spacing="8.0"
                                prefHeight="145.0"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #DBEAFE;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #93C5FD;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;
                                       -fx-padding: 20;">

                            <Label
                                    text="ROOM MANAGEMENT"
                                    textFill="#1D4ED8">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Manage Rooms"
                                    textFill="#172554">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="22.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Add, update, search and manage room availability."
                                    textFill="#475569"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>

                        </VBox>


                        <!-- CUSTOMER CARD -->

                        <VBox
                                spacing="8.0"
                                prefHeight="145.0"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #FCE7F3;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #F9A8D4;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;
                                       -fx-padding: 20;">

                            <Label
                                    text="CUSTOMERS"
                                    textFill="#BE185D">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Customer Management"
                                    textFill="#831843"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="21.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Manage customer information and records."
                                    textFill="#6B4055"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>

                        </VBox>


                        <!-- BOOKING CARD -->

                        <VBox
                                spacing="8.0"
                                prefHeight="145.0"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #DCFCE7;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #86EFAC;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;
                                       -fx-padding: 20;">

                            <Label
                                    text="RESERVATIONS"
                                    textFill="#15803D">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Booking Management"
                                    textFill="#14532D"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="21.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Create and manage hotel reservations."
                                    textFill="#46634F"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- QUICK ACCESS -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="12.0"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 12;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 12;
                                   -fx-border-width: 1;
                                   -fx-padding: 22;">

                        <Label
                                text="Quick Access"
                                textFill="#172554">

                            <font>

                                <Font
                                        name="System Bold"
                                        size="21.0"/>

                            </font>

                        </Label>


                        <Label
                                text="Choose a section to continue managing your hotel."
                                textFill="#64748B">

                            <font>

                                <Font
                                        name="System"
                                        size="14.0"/>

                            </font>

                        </Label>


                        <HBox spacing="12.0">

                            <!-- ROOM BUTTON -->

                            <Button
                                    maxWidth="Infinity"
                                    prefHeight="48.0"
                                    HBox.hgrow="ALWAYS"
                                    mnemonicParsing="false"
                                    onAction="#openRoomManagement"
                                    text="Room Management"
                                    style="-fx-background-color: #2563EB;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"/>


                            <!-- CUSTOMER BUTTON -->

                            <Button
                                    maxWidth="Infinity"
                                    prefHeight="48.0"
                                    HBox.hgrow="ALWAYS"
                                    mnemonicParsing="false"
                                    onAction="#openCustomerManagement"
                                    text="Customer Management"
                                    style="-fx-background-color: #DB2777;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"/>


                            <!-- BOOKING BUTTON -->

                            <Button
                                    maxWidth="Infinity"
                                    prefHeight="48.0"
                                    HBox.hgrow="ALWAYS"
                                    mnemonicParsing="false"
                                    onAction="#openBooking"
                                    text="New Booking"
                                    style="-fx-background-color: #16A34A;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"/>


                            <!-- FINANCE BUTTON -->

                            <Button
                                    maxWidth="Infinity"
                                    prefHeight="48.0"
                                    HBox.hgrow="ALWAYS"
                                    mnemonicParsing="false"
                                    onAction="#openFinance"
                                    text="Finance &amp; Reports"
                                    style="-fx-background-color: #7C3AED;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"/>


                            <!-- WEATHER BUTTON -->

                            <Button
                                    maxWidth="Infinity"
                                    prefHeight="48.0"
                                    HBox.hgrow="ALWAYS"
                                    mnemonicParsing="false"
                                    onAction="#openWeather"
                                    text="Weather"
                                    style="-fx-background-color: #0EA5E9;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- BOTTOM INFORMATION CARDS -->
                    <!-- ================================================= -->

                    <HBox spacing="18.0">


                        <!-- BOOKING HISTORY -->

                        <VBox
                                spacing="10.0"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #FFF7ED;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #FED7AA;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;
                                       -fx-padding: 22;">

                            <Label
                                    text="BOOKING HISTORY"
                                    textFill="#C2410C">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="View Reservations"
                                    textFill="#7C2D12">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="20.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Review previously created hotel bookings."
                                    textFill="#7C5B45"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Button
                                    prefHeight="40.0"
                                    mnemonicParsing="false"
                                    onAction="#openBookingHistory"
                                    text="Open History"
                                    style="-fx-background-color: #F97316;
                                           -fx-text-fill: white;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-cursor: hand;"/>

                        </VBox>


                        <!-- DATABASE -->

                        <VBox
                                spacing="10.0"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #F3E8FF;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #D8B4FE;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;
                                       -fx-padding: 22;">

                            <Label
                                    text="DATABASE"
                                    textFill="#7E22CE">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="SQLite Integrated"
                                    textFill="#581C87">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="20.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Rooms, customers and bookings are stored in SQLite."
                                    textFill="#6B4A7A"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>

                        </VBox>


                        <!-- WEATHER INFORMATION CARD -->

                        <VBox
                                spacing="10.0"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #E0F2FE;
                                       -fx-background-radius: 12;
                                       -fx-border-color: #7DD3FC;
                                       -fx-border-radius: 12;
                                       -fx-border-width: 1;
                                       -fx-padding: 22;">

                            <Label
                                    text="NETWORKING"
                                    textFill="#0369A1">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Live Weather"
                                    textFill="#075985">

                                <font>

                                    <Font
                                            name="System Bold"
                                            size="20.0"/>

                                </font>

                            </Label>


                            <Label
                                    text="Retrieve live weather data from an online API using JSON parsing."
                                    textFill="#475569"
                                    wrapText="true">

                                <font>

                                    <Font
                                            name="System"
                                            size="13.0"/>

                                </font>

                            </Label>


                            <Button
                                    prefHeight="40.0"
                                    mnemonicParsing="false"
                                    onAction="#openWeather"
                                    text="Open Weather"
                                    style="-fx-background-color: #0EA5E9;
                                           -fx-text-fill: white;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-cursor: hand;"/>

                        </VBox>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>


    <!-- ========================================================= -->
    <!-- BOTTOM -->
    <!-- ========================================================= -->

    <bottom>

        <HBox
                alignment="CENTER_RIGHT"
                spacing="15.0"
                prefHeight="70.0"
                style="-fx-background-color: white;
                       -fx-border-color: #E2E8F0;
                       -fx-border-width: 1 0 0 0;">

            <padding>

                <Insets
                        top="10.0"
                        right="25.0"
                        bottom="10.0"
                        left="25.0"/>

            </padding>


            <!-- REFRESH BUTTON -->

            <Button
                    fx:id="refreshDataButton"
                    onAction="#refreshData"
                    prefHeight="42.0"
                    prefWidth="150.0"
                    mnemonicParsing="false"
                    text="Refresh Data"
                    style="-fx-background-color: #2563EB;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>


            <!-- LOGOUT BUTTON -->

            <Button
                    fx:id="logoutButton"
                    onAction="#logout"
                    prefHeight="42.0"
                    prefWidth="120.0"
                    mnemonicParsing="false"
                    text="Logout"
                    style="-fx-background-color: #E2E8F0;
                           -fx-text-fill: #334155;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>